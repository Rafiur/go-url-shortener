# Copy to config.env for local development. In production these come from the
# host's environment instead (config.env is gitignored and not deployed).

PORT=8080

# --- Postgres ---------------------------------------------------------------
# Local docker-compose values. For Neon: take DBHOST/DBUSER/DBPASS/DBNAME from
# the dashboard connection string, set DBPORT=5432 and DBSSLMODE=require.
DBHOST=localhost
DBUSER=shortener
DBPASS=shortener
DBPORT=5434
DBNAME=shortener
DBSCHEMA=public
DBSSLMODE=disable

# --- Redis ------------------------------------------------------------------
# For Upstash: REDIS_ADDRESS=<endpoint>:6379, REDIS_PASSWORD=<token>, REDIS_TLS=true
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# --- Rate limiting (link creation only; redirects are never throttled) -------
CREATE_RATE_LIMIT=5
CREATE_RATE_BURST=10

# --- CORS -------------------------------------------------------------------
# Comma-separated origin allowlist. Leave empty to allow any origin. Only
# matters if the frontend is hosted apart from this binary (e.g. GitHub Pages).
ALLOWED_ORIGINS=

DEBUG=true

LOG_DEVELOPMENT=true
LOG_DISABLE_CALLER=false
LOG_DISABLE_STACKTRACE=false
LOG_ENCODING=console
LOG_LEVEL=debug